# ==============================================================================
# HAMSA OSINT ENTERPRISE PLATFORM - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env and adjust credentials to match your deployment:
#   cp .env.example .env
#
# Supported Operating Systems: Debian 11/12+, Ubuntu 20.04/22.04/24.04 LTS
# ==============================================================================

# --- DATABASE ENGINE (Options: "postgres" | "sqlite") ---
HAMSA_DB_ENGINE=postgres

# PostgreSQL Connection Settings
POSTGRES_USER=hamsa_admin
POSTGRES_PASSWORD=hamsa_secure_password_2026
POSTGRES_DB=hamsa_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Or provide a direct connection string / Cloud PostgreSQL DSN:
# DATABASE_URL=postgresql://hamsa_admin:hamsa_secure_password_2026@localhost:5432/hamsa_intelligence

# SQLite fallback path (used if HAMSA_DB_ENGINE=sqlite or PostgreSQL is unreachable)
SQLITE_DB_PATH=~/.hamsa/hamsa.db

# --- CACHE & EVENT ENGINE (Options: "redis" | "memory") ---
HAMSA_CACHE_ENGINE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- GRAPH DATABASE BACKEND (Options: "postgres" | "neo4j" | "memory") ---
HAMSA_GRAPH_BACKEND=postgres
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret

# --- WEB APPLICATION BACKEND SETTINGS ---
# CRITICAL NOTICE: Port 8080 is strictly RESERVED and will never be bound.
HAMSA_WEB_PORT=8888
HAMSA_WEB_HOST=0.0.0.0
HAMSA_WORKERS=4
HAMSA_ENVIRONMENT=production

# Security & Session Secrets
HAMSA_SECRET_KEY=change_this_to_a_random_32_character_string_for_production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8888
